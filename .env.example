# ---- AI providers (all have free tiers) ----
# Set as many as you like. When one is rate-limited or down, the server automatically
# moves on to the next. Each model also has its own free quota.

# Google Gemini: https://aistudio.google.com/apikey  (the only one that can read scanned PDFs)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# OpenRouter: https://openrouter.ai/keys  ("openrouter/free" picks any available free model)
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openrouter/free

# Order to try providers in (default shown)
# AI_PROVIDER_ORDER=gemini,groq,openrouter

# ---- Optional: enables "Add to Google Calendar". See README for setup. ----
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
